# ==============================================================================
# NaijaBites — environment variables
#
# HOW TO USE:
#   1. Copy this file to `.env.local` (which is git-ignored — never commit it)
#   2. Replace each `your-...-here` with the real value
#   3. Restart the dev server after any change (npm run dev)
#
# In production, the SAME variables are set in
# Vercel → Project → Settings → Environment Variables.
#
# RULE: anything prefixed NEXT_PUBLIC_ is visible in the browser —
#       never put a true secret there.
# ==============================================================================

# --- Supabase (Phase 3) ------------------------------------------------------
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
# Server-only! Bypasses RLS — never expose with NEXT_PUBLIC_ prefix.
# Use the SECRET key (starts with `sb_secret_`), not the publishable
# (anon) key (`sb_publishable_`) — RLS denies the publishable key everything.
# The legacy service_role JWT (`eyJ...`) also works.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-here

# --- Auth.js / NextAuth (Phase 2) --------------------------------------------
# Generate with: openssl rand -base64 32   (or use https://generate-secret.vercel.app/32)
AUTH_SECRET=your-auth-secret-here
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-here

# --- Site URL ----------------------------------------------------------------
# Local:  http://localhost:3000    Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paystack Test Mode (Phase 4) --------------------------------------------
# Paystack Dashboard → Settings → API Keys & Webhooks → Test keys
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key-here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-test-public-key-here

# --- Mailgun (Phase 5) -------------------------------------------------------
# Mailgun → Sending → API Keys / Domains
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=your-mailgun-domain-here
# Full from-address, e.g. NaijaBites <orders@mg.yourdomain.com>
MAILGUN_FROM=your-mailgun-from-address-here
