# ==============================================================================
# NaijaBites — environment variables
#
# HOW TO USE:
#   1. Copy this file to `.env.local` (which is git-ignored — never commit it)
#   2. Replace each `your-...-here` with the real value
#   3. Restart the dev server after any change (npm run dev)
#
# In production, the SAME variables are set in
# Vercel → Project → Settings → Environment Variables.
#
# RULE: anything prefixed NEXT_PUBLIC_ is visible in the browser —
#       never put a true secret there.
# ==============================================================================

# --- Supabase (Phase 3) ------------------------------------------------------
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
# Server-only! Bypasses RLS — never expose with NEXT_PUBLIC_ prefix.
# Use the SECRET key (starts with `sb_secret_`), not the publishable
# (anon) key (`sb_publishable_`) — RLS denies the publishable key everything.
# The legacy service_role JWT (`eyJ...`) also works.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-here

# --- Auth.js / NextAuth (Phase 2) --------------------------------------------
# Generate with: openssl rand -base64 32   (or use https://generate-secret.vercel.app/32)
AUTH_SECRET=your-auth-secret-here
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-here
# Lesson 3 mobile sign-in reuses ALL of the above as-is: the app runs this
# same Auth.js flow inside a browser tab and never holds a Google client id
# of its own (PRD-LESSON3 §4). No mobile-specific auth variables exist —
# and NO new redirect URI needs to be added in Google Cloud Console.

# --- Site URL ----------------------------------------------------------------
# Local:  http://localhost:3000    Production: your Vercel URL
# Phase 4: Paystack returns the customer here after paying. Paystack does NOT
# redirect to http:// or localhost ("Ensure you don't use localhost as your
# callback URL"), so:
#   - production: must be https:// — otherwise the app refuses (503) to start a
#     payment rather than charge the customer and create no order.
#   - development (npm run dev): localhost is allowed. The server logs a warning
#     and the checkout page shows a link to open BY HAND after paying:
#       /api/paystack/verify?reference=<reference>
#     For real redirects locally, use an HTTPS tunnel instead, e.g.
#       ngrok http 3000  ->  NEXT_PUBLIC_SITE_URL=https://<random>.ngrok.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paystack Test Mode (Phase 4) --------------------------------------------
# Paystack Dashboard → Settings → API Keys & Webhooks → Test keys
# (keep the dashboard in Test Mode for this project — PRD §11).
# The secret key is used SERVER-SIDE ONLY by /api/paystack/initialize and
# /api/paystack/verify. The redirect flow needs nothing else; the public key is
# kept for a future inline-JS integration and is safe to expose.
# Test card: 4084 0840 8408 4081 · CVV 408 · any future expiry · PIN 0000 · OTP 123456
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key-here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-test-public-key-here

# --- Mailgun (Phase 5) -------------------------------------------------------
# Mailgun → Sending → API Keys / Domains
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=your-mailgun-domain-here
# Full from-address, e.g. NaijaBites <orders@mg.yourdomain.com>
MAILGUN_FROM=your-mailgun-from-address-here
