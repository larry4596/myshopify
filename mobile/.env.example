# =============================================================================
# NaijaBites mobile — public runtime configuration
#
#   1. Copy this file to `.env` (git-ignored by the repo root).
#   2. Fill in the values.
#   3. Restart Metro (npm start) — EXPO_PUBLIC_* vars are inlined when the
#      bundle is built, so a restart is required after any change.
#
# EXPO_PUBLIC_* values ship INSIDE the APK. Only public values belong here:
# no Supabase keys, no Paystack secret — the Next.js BFF owns all secrets
# (PRD-LESSON3 §3).
# =============================================================================

# Origin of the deployed Next.js store, no trailing slash.
# Local development against `npm run dev` is: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=https://your-project.vercel.app

# That's it. Sign-in needs NOTHING else: the app opens the store's own
# browser login (Auth.js) and never holds a Google client id of its own —
# no EXPO_PUBLIC_GOOGLE_CLIENT_ID, no OAuth console changes (PRD §4).
